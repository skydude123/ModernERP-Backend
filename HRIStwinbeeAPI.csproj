<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.72" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="Telerik.Reporting" Version="20.1.26.707" />
    <PackageReference Include="Telerik.Reporting.OpenXmlRendering" Version="20.1.26.707" />
    <PackageReference Include="Telerik.Reporting.Services.AspNetCore" Version="20.1.26.707" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Reports\**\*.trdp">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Model\" />
    <Folder Include="Reports\" />
    <Folder Include="App_Data\ReportCache\" />
  </ItemGroup>

</Project>
